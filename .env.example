# Tre Fratelli Restaurant Website Environment Variables
# Public origin for metadataBase and canonical URLs
SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Table Reservations Email Delivery
# ------------------------------------------------------------------------------
# Choose ONE provider: smtp | resend | zeptomail | brevo
EMAIL_PROVIDER=smtp

# Restaurant inbox (comma-separated list of recipients; Ristorante.13fratelli@gmail.com is included by default)
RESERVATION_TO_EMAIL=Ristorante.13fratelli@gmail.com,georgehelal87@gmail.com
RESERVATION_TO_NAME=Tre Fratelli Prenotazioni

# Sender address on your domain (when using Zoho SMTP, must match SMTP_USER or a verified Zoho alias)
RESERVATION_FROM_EMAIL=
RESERVATION_FROM_NAME=Tre Fratelli Ristorante

# Option 1: Direct SMTP (Works on legacy/grandfathered Zoho Free or paid Zoho Mail Lite)
# Use smtp.zoho.com (Global/US) or smtp.zoho.eu (Europe) depending on your Zoho account region
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Use an App-Specific Password from Zoho Accounts -> Security -> App Passwords if 2FA is enabled
SMTP_PASS=

# Option 2 (Free Tier: 3,000 emails/month, useful for new Zoho Free accounts): Resend
RESEND_API_KEY=

# Option 3 (Official Zoho Transactional API): Zoho ZeptoMail
ZOHO_ZEPTOMAIL_TOKEN=
# Zoho datacenter region: eu | com | in | com.au | jp | ca | sa | uk
ZOHO_ZEPTOMAIL_REGION=eu

# Option 4 (Free Tier: 300 emails/day): Brevo
BREVO_API_KEY=

# Send a confirmation-received copy to the guest when they provide an email (true | false)
RESERVATION_SEND_GUEST_COPY=true

# Optional: alert email for delivery errors (defaults to RESERVATION_FROM_EMAIL when enabled)
RESERVATION_ALERT_ENABLED=true
# RESERVATION_ALERT_EMAIL=contact@getlumos.studio

# Optional: set to "preview" to allow staging demos before configuring email keys
# RESERVATION_DELIVERY_MODE=preview
